{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/Dream_Guardian_개발_규칙.md"
  ],
  "references": {
    "gdd": {
      "path": "docs/01_GAME_DESIGN_DOCUMENT.md",
      "description": "Dream Guardian 게임 기획서(GDD) - 게임 루프, 챕터/보스, 전투/모션/문제/UI 스펙"
    },
    "rules": {
      "path": "docs/Dream_Guardian_개발_규칙.md",
      "description": "Dream Guardian 안정적인 신규 개발 규칙 - 단일 기능, TDD, 수정 경계"
    },
    "issues": {
      "path": "docs/03_GITHUB_ISSUES.md",
      "description": "GitHub 이슈 및 세부 작업 카드 목록"
    },
    "wbs": {
      "path": "docs/02_WORK_BREAKDOWN_STRUCTURE.md",
      "description": "WBS 작업 분할 구조 및 단계별 마일스톤"
    },
    "questions": {
      "path": "questions.csv",
      "description": "전체 수학 문제 원본 CSV 데이터 (685문항, Level 1~9)"
    },
    "story": {
      "path": "docs/04_STORY_SOURCE.md",
      "description": "Dream Guardian 세계관 및 스토리 전문 (몽계, 꼬마 수호신, 4대 보스, 대사)"
    },
    "handover": {
      "path": "dream_guardian/HANDOVER.md",
      "description": "Dream Guardian 세션 간 실시간 작업 상태 및 인수인계 문서"
    },
    "patterns": {
      "path": "fitness pattern.csv",
      "description": "피트니스 패턴 원본 데이터 (360건, Single/Double/Triple/Quad)"
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh issue status*": "allow"
    }
  }
}