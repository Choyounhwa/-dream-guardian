{
  "name": "dream-guardian",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:ui-editor": "vite --config vite.ui-editor.config.ts",
    "build:ui-editor": "tsc && vite build --config vite.ui-editor.config.ts",
    "preview:ui-editor": "vite preview --config vite.ui-editor.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tweakpane": "^4.0.5",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
